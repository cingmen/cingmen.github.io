---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>Joesavat Donovan</name>
    <email>joesavat@gmail.com</email>
    <uri>{{ site.url }}/</uri>
  </author>
  <rights>© {{ site.time | date: '%Y' }} Joesavat Donovan</rights>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>

  {% for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title_en | default: post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.title_en | default: post.title | xml_escape }}"/>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ post.url }}</id>
    <summary type="html">{{ post.description_en | default: post.description | default: post.excerpt | strip_html | truncatewords: 50 | xml_escape }}</summary>
    <content type="html" xml:base="{{ site.url }}{{ post.url }}">{{ post.content | strip_html | truncatewords: 100 | xml_escape }}</content>
    {% if post.categories %}
    <category {% for category in post.categories %}term="{{ category }}" label="{{ category | xml_escape }}"{% unless forloop.last %} {% endunless %}{% endfor %}/>
    {% endif %}
  </entry>
  {% endfor %}
</feed>
